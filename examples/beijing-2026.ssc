// Historical Sky (example) -- Beijing, 2026-08-28 22:00 local time
// Self-contained: copy this single file into your Stellarium scripts folder and press
// F12 -> select it -> Run.
// Closest star to the zenith: HIP 99571 (Cygnus), 0.134 deg away.
// MIT License -- Created by A Star Named. Tested with Stellarium 26.2.
// https://astarnamed.com/?utm_source=github&utm_medium=example&utm_campaign=historical-sky

core.setObserverLocation(116.4074, 39.9042, 50, 0, "Beijing, China");
core.setDate("2026-08-28T14:00:00", "utc", false);  // 22:00 China Standard Time (UTC+8); false = static time
core.setTimeRate(0);

ConstellationMgr.setFlagLines(true);
ConstellationMgr.setFlagLabels(true);
LandscapeMgr.setFlagLandscape(true);
LandscapeMgr.setFlagAtmosphere(true);

core.moveToAltAzi(90, 0);
StelMovementMgr.zoomTo(5, 1);

core.debug("Historical Sky: 2026-08-28 22:00 -- Beijing, China");
